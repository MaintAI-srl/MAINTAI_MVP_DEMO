{
  "name": "frontend",
  "version": "3.3.2",
  "private": true,
  "scripts": {
    "dev": "node ../scripts/copy_pdfjs_assets.mjs && next dev",
    "build": "node ../scripts/copy_pdfjs_assets.mjs && node ../scripts/deploy_version.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "build:desktop": "node ../scripts/copy_pdfjs_assets.mjs && cross-env DESKTOP_BUILD=true NEXT_PUBLIC_API_BASE=https://maintai-v3.onrender.com next build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "//overrides": [
    "next 16.2.x pinna internamente postcss a 8.4.31 e sharp a ^0.34.5, entrambe versioni",
    "con advisory high aperte (GHSA-qx2v-qp2m-jg93, GHSA-6g55-p6wh-862q, GHSA-r28c-9q8g-f849,",
    "GHSA-f88m-g3jw-g9cj). `npm audit fix` non le risolve perché non può toccare le dipendenze",
    "dirette di next: servono override espliciti. Sono entrambi bump minori nella stessa major.",
    "Rimuovere quando next dichiarerà da solo versioni non vulnerabili."
  ],
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/webxr": "^0.5.24",
    "autoprefixer": "^10.4.27",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.2.1",
    "typescript": "^5"
  }
}
