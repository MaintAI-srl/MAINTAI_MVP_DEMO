# Copia questo file in .env e compila i valori reali
# NON committare mai il file .env nel repository

# Database (PostgreSQL in cloud, SQLite in locale)
#
# Connessione DIRETTA (username = "postgres"):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
#
# Pooler Supabase / Supavisor (consigliato in produzione, es. Render):
# ATTENZIONE: con il pooler lo username DEVE essere "postgres.<project-ref>",
# altrimenti il pooler rifiuta l'auth e apre il circuit breaker (ECIRCUITBREAKER).
#   - Session mode (porta 5432):     postgres.PROJECT:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
#   - Transaction mode (porta 6543): postgres.PROJECT:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
#
# Per sviluppo locale con SQLite:
# DATABASE_URL=sqlite:///./maintai.db

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# JWT Auth — OBBLIGATORIA: il backend NON si avvia se manca.
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-con-stringa-casuale-almeno-32-caratteri

# Cifratura password IMAP (Fernet) — OBBLIGATORIA: il backend NON si avvia se manca o è malformata.
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Sessione / cookie
# Durata access token in minuti (default 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# "true" OBBLIGATORIO in produzione (cookie solo via HTTPS). In locale lascia vuoto.
COOKIE_SECURE=
# lax | strict | none
COOKIE_SAMESITE=lax

# Retention log di sicurezza in giorni (minimo applicato: 365 = 12 mesi, NIS2/ISO 27002 A.8.15).
# Valori inferiori a 365 vengono ignorati e riportati al minimo di compliance.
LOG_RETENTION_DAYS=365

# Supabase Storage (lascia vuoto per usare uploads/ locale)
SUPABASE_URL=https://XXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_BUCKET=maintai-uploads

# CORS (comma-separated, aggiorna con URL Vercel dopo deploy)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://TUO-PROGETTO.vercel.app

# ── Livello commerciale SaaS (self-service) ──────────────────────────────────
# Vedi docs/SAAS_SELF_SERVICE.md
#
# Provider di pagamento: "local" (checkout simulato, nessuna rete) o "stripe".
# Lasciando vuoto: stripe se STRIPE_SECRET_KEY è presente, altrimenti local.
BILLING_PROVIDER=local
# Segreto del webhook del provider locale. Senza, l'endpoint /billing/webhook è chiuso.
BILLING_WEBHOOK_SECRET=
# Giorni di tolleranza dopo un pagamento fallito (accesso pieno con banner).
BILLING_GRACE_DAYS=7
# Durata della prova gratuita.
TRIAL_DAYS=14
# Finestra di ripensamento sulla cancellazione account.
ACCOUNT_RETENTION_DAYS=30

# Registrazione pubblica. IMPORTANTE: default spento in produzione — aprire la
# creazione di tenant a chiunque è una decisione commerciale, non l'effetto
# collaterale di un deploy. In locale è attiva senza doverla impostare.
SELF_SERVICE_SIGNUP_ENABLED=

# Base dei link nelle email transazionali e degli URL di checkout.
APP_PUBLIC_URL=http://localhost:3000

# Versione dei documenti accettati in registrazione (registrata col consenso).
TERMS_VERSION=2026-08-01
PRIVACY_VERSION=2026-08-01

# Email transazionali (verifica indirizzo, reset password).
# Senza SMTP_URL: in sviluppo il messaggio va nei log, in produzione è un errore.
#   smtp://utente:password@host:587   (STARTTLS)
#   smtps://utente:password@host:465  (TLS implicito)
SMTP_URL=
EMAIL_FROM=MaintAI <no-reply@maintai.it>

# ── Stripe (solo con BILLING_PROVIDER=stripe; richiede `pip install stripe`) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START_MONTHLY=
STRIPE_PRICE_START_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_EXTRA_USER_MONTHLY=
STRIPE_PRICE_EXTRA_SITE_MONTHLY=
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
